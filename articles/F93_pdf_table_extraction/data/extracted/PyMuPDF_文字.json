 ∙𝑓𝑙𝑖∙𝑥𝑙𝑖∙𝑟𝑙𝑖 = ෍෍𝑥𝑙𝑖𝑟𝑙𝑖𝐹𝑙"], ["𝑚𝑙 𝑤𝑙𝑖 𝐿 𝑚𝑙 𝐿 𝑚𝑙"], ["𝑙=1 𝑖=1 𝑙=1 𝑖=1"], ["෍1 ෍𝑤𝑙"], ["∙𝑓𝑙𝑖∙𝑃𝑙𝑖∙𝑟𝑙𝑖 ෍෍𝑃𝑙𝑖∙𝑟𝑙𝑖∙𝐹𝑙"], ["𝑚𝑙 𝑤𝑙𝑖"], ["ここで"], ["𝑙=1 𝑖=1 𝑙=1 𝑖=1"], ["𝑙 : 11 地域、層による区分の番号（𝑙= 1、 2、 ⋯、 𝐿）"], ["𝑖 : 各区分中の標本調査区の番号（𝑖= 1、 2、 ⋯、 𝑚௟）"], ["𝑥௟௜ : 第𝑙区分、第𝑖標本調査区内の属性𝑋を有する調査人口（男女、年齢階級別）"], ["𝑤௟௜ : 第𝑙区分、第𝑖標本調査区のウエイト"], ["𝑓௟௜ : 第𝑙区分、第𝑖標本調査区の住戸の抽出率の逆数（𝑓௟௜= 𝑤௟௜）"], ["𝑤௟ : 第𝑙区分に含まれる全ての調査区のウエイトの合計"], ["𝑚௟ : 第𝑙区分の標本調査区数"], ["𝑟௟௜ : 第𝑙区分、第𝑖標本調査区の修正倍率（調査区の分割など。０＜𝑟௟௜≦２）"], ["𝐹௟ : 第𝑙区分の抽出間隔（𝐹௟= 𝑤௟/𝑚௟）"], [": 線型推定用乗率（𝑟௟௜∙𝐹௟）"], ["𝑃 : ベンチマーク人口（男女、年齢階級、地域別）"], ["𝑃௟௜ : 第𝑙区分、第𝑖標本調査区内の調査人口（男女、年齢階級別）"], ["𝑃"], ["𝐿 𝑚𝑙 は比推定用乗率"], ["෍෍𝑃𝑙𝑖∙𝑟𝑙𝑖∙𝐹𝑙"], ["𝑙=1 𝑖=1"], ["(3) ベンチマーク人口及びベンチマーク人口の基準切替え"], ["ア 結果を算出するためのベンチマーク人口には、「人口推計」（総務省統計局）を用いる。人口推計で"], ["は、国勢調査による人口を基礎に、その後の人口の動きを他の人口関連資料から得て、月末現在で加"], ["減することにより、毎月１日現在の推計人口を算出しており、月末１週間を調査期間とする労働力調"], ["査においては、翌月１日現在の概算値を用いることとしている＊。"], ["＊"], ["2007 年から推計人口の算出に用いる社会動態について、日本人の出入（帰）国者数を「海外滞在期"], ["間91 日以上出入（帰）国者数」を用いて算出する方法に変更した。"], ["イ ベンチマーク人口となる推計人口は、最新の国勢調査の人口を基礎としており、５年ごとに新たな"], ["国勢調査の確定人口に基づく計算値に基準切替えが行われる。このため、労働力調査の結果の算出に"], ["用いる基準人口も５年ごとに基準切替えが行われる。旧基準による推計人口と新基準による推計人口"], ["との間に相違がある場合、労働力調査の基準人口の基準切替えが行われた年の結果には、これに伴う"], ["変動分が含まれる。"], ["なお、労働力調査における2022 年平均公表時の基準人口は、2020 年国勢調査の確定人口に基づく"], ["もので、旧基準の2015 年国勢調査から新基準の2020 年国勢調査への基準切替えは、基本集計は2022"], ["年１月、詳細集計は2022 年１～３月期平均から行った。"], ["（参考１）基準人口の切替え等による変動分（基本集計）（推計；概数）〔単位 万人、ポイント〕"], ["15 歳以上 完全 非労働力 完全"], ["就業者数"], ["人口 失業者数 人口 失業率"], ["1982 年１月切替え(1981 年平均結果)"], ["－ 4 － 3 0 － 1 0.0"], ["（1980 年国勢調査基準への切替え）"], ["1987 年１月切替え(1986 年平均結果)"], ["＋ 7 ＋ 4 0 ＋ 3 0.0"], ["（1985 年国勢調査基準への切替え）"], ["1992 年１月切替え(1991 年平均結果)"], ["－11 － 7 0 － 4 0.0"], ["（1990 年国勢調査基準への切替え）"], ["1997 年１月切替え(1996 年平均結果)"], ["＋28 ＋17 ＋ 1 ＋10 0.0"], ["（1995 年国勢調査基準への切替え）"], ["2002 年１月切替え(2001 年平均結果)"], ["－ 6 － 4 0 － 2 0.0"], ["（2000 年国勢調査基準への切替え）"], ["2007 年１月切替え(2006 年平均結果)"], ["＋ 6 － 6 － 1 ＋13 0.0"], ["（2005 年国勢調査基準への切替え）"], ["2012 年１月切替え(2011 年12 月結果)"], ["＋69 ＋44 ＋ 1 ＋24 0.0"], ["（2010 年国勢調査基準への切替え）"], ["2017 年１月切替え(2015