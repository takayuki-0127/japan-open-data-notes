// F249 サンプルマート（架空）の DAX メジャー。会社・数字は架空（合成データ）。
// 使い方：Power BI Desktop の「DAX クエリ ビュー」に全部貼り、上に出る「モデルの更新：新しいメジャーを追加」を押す。
//         そのあと「実行」すると、最後の EVALUATE が FY ごとの値を出す（powerbi/expected_values.csv と比べる）。
// この DAX は Power BI Desktop では動かしていない。期待値は pandas と SQL で計算して一致を確かめたもの。

DEFINE
    // [1 基本] 売上（円）
    MEASURE 'fact_store_day'[売上] =
        SUM('fact_store_day'[sales])
    // [1 基本] 客数（レシートの枚数）
    MEASURE 'fact_store_day'[レシート] =
        SUM('fact_store_day'[receipts])
    // [1 基本] 買上点数の合計
    MEASURE 'fact_store_day'[点数] =
        SUM('fact_store_day'[items])
    // [1 基本] 廃棄前の粗利
    MEASURE 'fact_store_day'[粗利_廃棄前] =
        SUM('fact_store_day'[gross_profit_before_waste])
    // [1 基本] 廃棄・値引きロス
    MEASURE 'fact_store_day'[廃棄] =
        SUM('fact_store_day'[waste])
    // [1 基本] 廃棄後の粗利
    MEASURE 'fact_store_day'[粗利_廃棄後] =
        SUM('fact_store_day'[gross_profit])
    // [1 基本] 人時
    MEASURE 'fact_store_day'[人時] =
        SUM('fact_store_day'[labor_hours])
    // [1 基本] 人件費
    MEASURE 'fact_store_day'[人件費] =
        SUM('fact_store_day'[labor_cost])
    // [1 基本] その他の経費（店×月）
    MEASURE 'fact_store_day'[その他経費] =
        SUM('fact_store_month'[other_cost])
    // [1 基本] 会員のレシート
    MEASURE 'fact_store_day'[会員レシート] =
        SUM('fact_member_month'[member_receipts])
    // [1 基本] 来店した会員の人数（店×月）
    MEASURE 'fact_store_day'[会員数] =
        SUM('fact_member_month'[active_members])
    // [1 基本] 営業利益 ＝ 粗利（廃棄後）− 人件費 − その他の経費
    MEASURE 'fact_store_day'[営業利益] =
        [粗利_廃棄後] - [人件費] - [その他経費]
    // [2 既存店] 月ごとに、その月の既存店だけの売上（円）を足す
    MEASURE 'fact_store_day'[既存店売上] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [売上], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ) )
        )
    // [2 既存店] 月ごとに、その月の既存店（同じ店）の前年同月の売上（円）を足す
    MEASURE 'fact_store_day'[既存店売上_前年] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [売上], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ),
                DATEADD ( 'dim_date'[date], -12, MONTH ) )
        )
    // [2 既存店] 月ごとに、その月の既存店だけの客数（レシートの枚数）を足す
    MEASURE 'fact_store_day'[既存店レシート] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [レシート], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ) )
        )
    // [2 既存店] 月ごとに、その月の既存店（同じ店）の前年同月の客数（レシートの枚数）を足す
    MEASURE 'fact_store_day'[既存店レシート_前年] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [レシート], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ),
                DATEADD ( 'dim_date'[date], -12, MONTH ) )
        )
    // [2 既存店] 月ごとに、その月の既存店だけの買上点数の合計を足す
    MEASURE 'fact_store_day'[既存店点数] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [点数], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ) )
        )
    // [2 既存店] 月ごとに、その月の既存店（同じ店）の前年同月の買上点数の合計を足す
    MEASURE 'fact_store_day'[既存店点数_前年] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [点数], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ),
                DATEADD ( 'dim_date'[date], -12, MONTH ) )
        )
    // [2 既存店] 月ごとに、その月の既存店だけの廃棄前の粗利を足す
    MEASURE 'fact_store_day'[既存店粗利_廃棄前] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [粗利_廃棄前], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ) )
        )
    // [2 既存店] 月ごとに、その月の既存店（同じ店）の前年同月の廃棄前の粗利を足す
    MEASURE 'fact_store_day'[既存店粗利_廃棄前_前年] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [粗利_廃棄前], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ),
                DATEADD ( 'dim_date'[date], -12, MONTH ) )
        )
    // [2 既存店] 月ごとに、その月の既存店だけの廃棄・値引きロスを足す
    MEASURE 'fact_store_day'[既存店廃棄] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [廃棄], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ) )
        )
    // [2 既存店] 月ごとに、その月の既存店（同じ店）の前年同月の廃棄・値引きロスを足す
    MEASURE 'fact_store_day'[既存店廃棄_前年] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [廃棄], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ),
                DATEADD ( 'dim_date'[date], -12, MONTH ) )
        )
    // [2 既存店] 月ごとに、その月の既存店だけの廃棄後の粗利を足す
    MEASURE 'fact_store_day'[既存店粗利_廃棄後] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [粗利_廃棄後], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ) )
        )
    // [2 既存店] 月ごとに、その月の既存店（同じ店）の前年同月の廃棄後の粗利を足す
    MEASURE 'fact_store_day'[既存店粗利_廃棄後_前年] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [粗利_廃棄後], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ),
                DATEADD ( 'dim_date'[date], -12, MONTH ) )
        )
    // [2 既存店] 月ごとに、その月の既存店だけの人時を足す
    MEASURE 'fact_store_day'[既存店人時] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [人時], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ) )
        )
    // [2 既存店] 月ごとに、その月の既存店（同じ店）の前年同月の人時を足す
    MEASURE 'fact_store_day'[既存店人時_前年] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [人時], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ),
                DATEADD ( 'dim_date'[date], -12, MONTH ) )
        )
    // [2 既存店] 月ごとに、その月の既存店だけの人件費を足す
    MEASURE 'fact_store_day'[既存店人件費] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [人件費], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ) )
        )
    // [2 既存店] 月ごとに、その月の既存店（同じ店）の前年同月の人件費を足す
    MEASURE 'fact_store_day'[既存店人件費_前年] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [人件費], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ),
                DATEADD ( 'dim_date'[date], -12, MONTH ) )
        )
    // [2 既存店] 月ごとに、その月の既存店だけのその他の経費（店×月）を足す
    MEASURE 'fact_store_day'[既存店その他経費] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [その他経費], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ) )
        )
    // [2 既存店] 月ごとに、その月の既存店（同じ店）の前年同月のその他の経費（店×月）を足す
    MEASURE 'fact_store_day'[既存店その他経費_前年] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [その他経費], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ),
                DATEADD ( 'dim_date'[date], -12, MONTH ) )
        )
    // [2 既存店] 月ごとに、その月の既存店だけの会員のレシートを足す
    MEASURE 'fact_store_day'[既存店会員レシート] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [会員レシート], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ) )
        )
    // [2 既存店] 月ごとに、その月の既存店（同じ店）の前年同月の会員のレシートを足す
    MEASURE 'fact_store_day'[既存店会員レシート_前年] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [会員レシート], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ),
                DATEADD ( 'dim_date'[date], -12, MONTH ) )
        )
    // [2 既存店] 月ごとに、その月の既存店だけの来店した会員の人数（店×月）を足す
    MEASURE 'fact_store_day'[既存店会員数] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [会員数], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ) )
        )
    // [2 既存店] 月ごとに、その月の既存店（同じ店）の前年同月の来店した会員の人数（店×月）を足す
    MEASURE 'fact_store_day'[既存店会員数_前年] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [会員数], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ),
                DATEADD ( 'dim_date'[date], -12, MONTH ) )
        )
    // [2 既存店] 既存店の営業利益
    MEASURE 'fact_store_day'[既存店営業利益] =
        [既存店粗利_廃棄後] - [既存店人件費] - [既存店その他経費]
    // [2 既存店] 同じ店の前年同月の営業利益
    MEASURE 'fact_store_day'[既存店営業利益_前年] =
        [既存店粗利_廃棄後_前年] - [既存店人件費_前年] - [既存店その他経費_前年]
    // [3 KPI] K01 既存店売上の前年比（補正前）
    MEASURE 'fact_store_day'[既存店売上_前年比] =
        DIVIDE ( [既存店売上], [既存店売上_前年] ) - 1
    // [3 KPI] 曜日・祝日の並びだけで動く分（dim_date[day_weight] の合計の比）
    MEASURE 'fact_store_day'[曜日の並びの効果] =
        DIVIDE ( SUM ( 'dim_date'[day_weight] ), CALCULATE ( SUM ( 'dim_date'[day_weight] ), DATEADD ( 'dim_date'[date], -12, MONTH ) ) ) - 1
    // [3 KPI] K01 曜日・祝日の並びを補正した前年比
    MEASURE 'fact_store_day'[既存店売上_前年比_曜日補正] =
        DIVIDE ( 1 + [既存店売上_前年比], 1 + [曜日の並びの効果] ) - 1
    // [3 KPI] K02 客数（レシート）
    MEASURE 'fact_store_day'[既存店客数_前年比] =
        DIVIDE ( [既存店レシート], [既存店レシート_前年] ) - 1
    // [3 KPI] K03 買上点数（1回あたり）
    MEASURE 'fact_store_day'[既存店買上点数] =
        DIVIDE ( [既存店点数], [既存店レシート] )
    // [3 KPI] K03 の前年比
    MEASURE 'fact_store_day'[既存店買上点数_前年比] =
        DIVIDE ( [既存店買上点数], DIVIDE ( [既存店点数_前年], [既存店レシート_前年] ) ) - 1
    // [3 KPI] K04 一品単価（円）
    MEASURE 'fact_store_day'[既存店一品単価] =
        DIVIDE ( [既存店売上], [既存店点数] )
    // [3 KPI] K04 の前年比
    MEASURE 'fact_store_day'[既存店一品単価_前年比] =
        DIVIDE ( [既存店一品単価], DIVIDE ( [既存店売上_前年], [既存店点数_前年] ) ) - 1
    // [3 KPI] K06 粗利率（廃棄後）
    MEASURE 'fact_store_day'[既存店粗利率_廃棄後] =
        DIVIDE ( [既存店粗利_廃棄後], [既存店売上] )
    // [3 KPI] K06 の前年差（比で。0.001＝0.1pt）
    MEASURE 'fact_store_day'[既存店粗利率_廃棄後_前年差] =
        [既存店粗利率_廃棄後] - DIVIDE ( [既存店粗利_廃棄後_前年], [既存店売上_前年] )
    // [3 KPI] K07 廃棄率
    MEASURE 'fact_store_day'[既存店廃棄率] =
        DIVIDE ( [既存店廃棄], [既存店売上] )
    // [3 KPI] K07 の前年差
    MEASURE 'fact_store_day'[既存店廃棄率_前年差] =
        [既存店廃棄率] - DIVIDE ( [既存店廃棄_前年], [既存店売上_前年] )
    // [3 KPI] K08 人時粗利（円／人時）
    MEASURE 'fact_store_day'[既存店人時粗利] =
        DIVIDE ( [既存店粗利_廃棄後], [既存店人時] )
    // [3 KPI] K08 の前年比
    MEASURE 'fact_store_day'[既存店人時粗利_前年比] =
        DIVIDE ( [既存店人時粗利], DIVIDE ( [既存店粗利_廃棄後_前年], [既存店人時_前年] ) ) - 1
    // [3 KPI] K09 人件費率（補助）
    MEASURE 'fact_store_day'[既存店人件費率] =
        DIVIDE ( [既存店人件費], [既存店売上] )
    // [3 KPI] K09 の前年差
    MEASURE 'fact_store_day'[既存店人件費率_前年差] =
        [既存店人件費率] - DIVIDE ( [既存店人件費_前年], [既存店売上_前年] )
    // [3 KPI] K00 営業利益（KGI）の前年比。1店・月では幅 ±205% で使わない
    MEASURE 'fact_store_day'[既存店営業利益_前年比] =
        DIVIDE ( [既存店営業利益], [既存店営業利益_前年] ) - 1
    // [3 KPI] K05 来店頻度（会員、月あたり）
    MEASURE 'fact_store_day'[来店頻度_会員] =
        DIVIDE ( [既存店会員レシート], [既存店会員数] )
    // [3 KPI] K05 の前年比
    MEASURE 'fact_store_day'[来店頻度_会員_前年比] =
        DIVIDE ( [来店頻度_会員], DIVIDE ( [既存店会員レシート_前年], [既存店会員数_前年] ) ) - 1
    // [3 KPI] 店の行で使う。見えている店ぜんぶ（RLS の地域の責任者なら自分の地域）との差
    MEASURE 'fact_store_day'[既存店売上_前年比_全社との差] =
        [既存店売上_前年比_曜日補正] - CALCULATE ( [既存店売上_前年比_曜日補正], ALLSELECTED ( 'dim_store' ) )
    // [4 橋] 売上が伸びた分の粗利（前年の粗利率で）
    MEASURE 'fact_store_day'[橋_売上の伸び] =
        ( [既存店売上] - [既存店売上_前年] ) * DIVIDE ( [既存店粗利_廃棄前_前年], [既存店売上_前年] )
    // [4 橋] 値入れ（廃棄前の粗利率）が変わった分
    MEASURE 'fact_store_day'[橋_廃棄前の粗利率] =
        [既存店売上] * ( DIVIDE ( [既存店粗利_廃棄前], [既存店売上] ) - DIVIDE ( [既存店粗利_廃棄前_前年], [既存店売上_前年] ) )
    // [4 橋] 廃棄の増加（マイナスが悪化）
    MEASURE 'fact_store_day'[橋_廃棄] =
        - ( [既存店廃棄] - [既存店廃棄_前年] )
    // [4 橋] 人件費の増加
    MEASURE 'fact_store_day'[橋_人件費] =
        - ( [既存店人件費] - [既存店人件費_前年] )
    // [4 橋] その他の経費の増加
    MEASURE 'fact_store_day'[橋_その他経費] =
        - ( [既存店その他経費] - [既存店その他経費_前年] )
    // [5 日次] 同じ曜日どうし（52週前）
    MEASURE 'fact_store_day'[売上_364日前] =
        CALCULATE ( [売上], DATEADD ( 'dim_date'[date], -364, DAY ) )
    // [5 日次] 日・週の前年比（F246：日は364日前）。1店・日の幅は ±20%
    MEASURE 'fact_store_day'[売上_前年同曜日比] =
        DIVIDE ( [売上], [売上_364日前] ) - 1
    // [6 部門] 部門の売上
    MEASURE 'fact_store_day'[部門売上] =
        SUM ( 'fact_store_day_category'[sales] )
    // [6 部門] 部門の廃棄前の粗利
    MEASURE 'fact_store_day'[部門粗利_廃棄前] =
        SUM ( 'fact_store_day_category'[gross_profit_before_waste] )
    // [6 部門] 部門の廃棄
    MEASURE 'fact_store_day'[部門廃棄] =
        SUM ( 'fact_store_day_category'[waste] )
    // [6 部門] 既存店の部門売上
    MEASURE 'fact_store_day'[部門_既存店売上] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [部門売上], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ) )
        )
    // [6 部門] 同じ店の前年同月の部門売上
    MEASURE 'fact_store_day'[部門_既存店売上_前年] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [部門売上], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ),
                DATEADD ( 'dim_date'[date], -12, MONTH ) )
        )
    // [6 部門] 既存店の部門粗利_廃棄前
    MEASURE 'fact_store_day'[部門_既存店粗利_廃棄前] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [部門粗利_廃棄前], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ) )
        )
    // [6 部門] 同じ店の前年同月の部門粗利_廃棄前
    MEASURE 'fact_store_day'[部門_既存店粗利_廃棄前_前年] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [部門粗利_廃棄前], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ),
                DATEADD ( 'dim_date'[date], -12, MONTH ) )
        )
    // [6 部門] 既存店の部門廃棄
    MEASURE 'fact_store_day'[部門_既存店廃棄] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [部門廃棄], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ) )
        )
    // [6 部門] 同じ店の前年同月の部門廃棄
    MEASURE 'fact_store_day'[部門_既存店廃棄_前年] =
        SUMX (
            VALUES ( 'dim_date'[month_start] ),
            VAR S = CALCULATETABLE ( VALUES ( 'fact_store_month'[store_id] ), 'fact_store_month'[is_existing] = 1 )
            RETURN CALCULATE ( [部門廃棄], KEEPFILTERS ( TREATAS ( S, 'dim_store'[store_id] ) ),
                DATEADD ( 'dim_date'[date], -12, MONTH ) )
        )
    // [6 部門] 部門の売上の前年比
    MEASURE 'fact_store_day'[部門_既存店売上_前年比] =
        DIVIDE ( [部門_既存店売上], [部門_既存店売上_前年] ) - 1
    // [6 部門] 部門の粗利率（廃棄後）
    MEASURE 'fact_store_day'[部門_既存店粗利率_廃棄後] =
        DIVIDE ( [部門_既存店粗利_廃棄前] - [部門_既存店廃棄], [部門_既存店売上] )
    // [6 部門] その前年差
    MEASURE 'fact_store_day'[部門_既存店粗利率_廃棄後_前年差] =
        [部門_既存店粗利率_廃棄後] - DIVIDE ( [部門_既存店粗利_廃棄前_前年] - [部門_既存店廃棄_前年], [部門_既存店売上_前年] )
    // [6 部門] 部門の廃棄率
    MEASURE 'fact_store_day'[部門_既存店廃棄率] =
        DIVIDE ( [部門_既存店廃棄], [部門_既存店売上] )
    // [6 部門] その前年差
    MEASURE 'fact_store_day'[部門_既存店廃棄率_前年差] =
        [部門_既存店廃棄率] - DIVIDE ( [部門_既存店廃棄_前年], [部門_既存店売上_前年] )
    // [7 幅と色] いま見ている範囲（1店・地域・全社）。RLS で1つの地域だけ見える人は「地域」になる
    MEASURE 'fact_store_day'[幅の範囲] =
        SWITCH (
            TRUE (),
            HASONEVALUE ( 'dim_store'[store_id] ), "1店",
            HASONEVALUE ( 'dim_store'[area] ), "地域",
            "全社"
        )
    // [7 幅と色] 1か月なら「月」、12か月なら「12か月」。それ以外は幅を出さない（色をつけない）
    MEASURE 'fact_store_day'[幅の粒度] =
        VAR n = DISTINCTCOUNT ( 'dim_date'[ym] )
        RETURN SWITCH ( TRUE (), n = 1, "月", n = 12, "12か月", BLANK () )
    // [7 幅と色] 売上の偶然の幅（比。0.013＝±1.3%、率は 0.0005＝±0.05pt）
    MEASURE 'fact_store_day'[幅_売上] =
        VAR lv = [幅の範囲]
        VAR gr = [幅の粒度]
        RETURN IF ( ISBLANK ( gr ), BLANK (),
            LOOKUPVALUE ( 'ref_noise_band'[band_ratio], 'ref_noise_band'[level], lv, 'ref_noise_band'[grain], gr, 'ref_noise_band'[KPI], "売上" ) )
    // [7 幅と色] 客数の偶然の幅（比。0.013＝±1.3%、率は 0.0005＝±0.05pt）
    MEASURE 'fact_store_day'[幅_客数] =
        VAR lv = [幅の範囲]
        VAR gr = [幅の粒度]
        RETURN IF ( ISBLANK ( gr ), BLANK (),
            LOOKUPVALUE ( 'ref_noise_band'[band_ratio], 'ref_noise_band'[level], lv, 'ref_noise_band'[grain], gr, 'ref_noise_band'[KPI], "客数" ) )
    // [7 幅と色] 買上点数の偶然の幅（比。0.013＝±1.3%、率は 0.0005＝±0.05pt）
    MEASURE 'fact_store_day'[幅_買上点数] =
        VAR lv = [幅の範囲]
        VAR gr = [幅の粒度]
        RETURN IF ( ISBLANK ( gr ), BLANK (),
            LOOKUPVALUE ( 'ref_noise_band'[band_ratio], 'ref_noise_band'[level], lv, 'ref_noise_band'[grain], gr, 'ref_noise_band'[KPI], "買上点数" ) )
    // [7 幅と色] 一品単価の偶然の幅（比。0.013＝±1.3%、率は 0.0005＝±0.05pt）
    MEASURE 'fact_store_day'[幅_一品単価] =
        VAR lv = [幅の範囲]
        VAR gr = [幅の粒度]
        RETURN IF ( ISBLANK ( gr ), BLANK (),
            LOOKUPVALUE ( 'ref_noise_band'[band_ratio], 'ref_noise_band'[level], lv, 'ref_noise_band'[grain], gr, 'ref_noise_band'[KPI], "一品単価" ) )
    // [7 幅と色] 粗利率（廃棄後）の偶然の幅（比。0.013＝±1.3%、率は 0.0005＝±0.05pt）
    MEASURE 'fact_store_day'[幅_粗利率] =
        VAR lv = [幅の範囲]
        VAR gr = [幅の粒度]
        RETURN IF ( ISBLANK ( gr ), BLANK (),
            LOOKUPVALUE ( 'ref_noise_band'[band_ratio], 'ref_noise_band'[level], lv, 'ref_noise_band'[grain], gr, 'ref_noise_band'[KPI], "粗利率（廃棄後）" ) )
    // [7 幅と色] 廃棄率の偶然の幅（比。0.013＝±1.3%、率は 0.0005＝±0.05pt）
    MEASURE 'fact_store_day'[幅_廃棄率] =
        VAR lv = [幅の範囲]
        VAR gr = [幅の粒度]
        RETURN IF ( ISBLANK ( gr ), BLANK (),
            LOOKUPVALUE ( 'ref_noise_band'[band_ratio], 'ref_noise_band'[level], lv, 'ref_noise_band'[grain], gr, 'ref_noise_band'[KPI], "廃棄率" ) )
    // [7 幅と色] 人時粗利の偶然の幅（比。0.013＝±1.3%、率は 0.0005＝±0.05pt）
    MEASURE 'fact_store_day'[幅_人時粗利] =
        VAR lv = [幅の範囲]
        VAR gr = [幅の粒度]
        RETURN IF ( ISBLANK ( gr ), BLANK (),
            LOOKUPVALUE ( 'ref_noise_band'[band_ratio], 'ref_noise_band'[level], lv, 'ref_noise_band'[grain], gr, 'ref_noise_band'[KPI], "人時粗利" ) )
    // [7 幅と色] 営業利益の偶然の幅（比。0.013＝±1.3%、率は 0.0005＝±0.05pt）
    MEASURE 'fact_store_day'[幅_営業利益] =
        VAR lv = [幅の範囲]
        VAR gr = [幅の粒度]
        RETURN IF ( ISBLANK ( gr ), BLANK (),
            LOOKUPVALUE ( 'ref_noise_band'[band_ratio], 'ref_noise_band'[level], lv, 'ref_noise_band'[grain], gr, 'ref_noise_band'[KPI], "営業利益" ) )
    // [7 幅と色] 条件付き書式（フィールド値）に使う。幅の内＝灰、外＝良い青・悪い橙・物価は紫
    MEASURE 'fact_store_day'[色_既存店売上] =
        VAR v = [既存店売上_前年比_曜日補正]
        VAR b = [幅_売上]
        RETURN SWITCH ( TRUE (),
            ISBLANK ( v ) || ISBLANK ( b ) || ABS ( v ) <= b, "#A3A29D",
            IF ( v > 0, "#2A78D6", "#EB6834" ) )
    // [7 幅と色] 条件付き書式（フィールド値）に使う。幅の内＝灰、外＝良い青・悪い橙・物価は紫
    MEASURE 'fact_store_day'[色_客数] =
        VAR v = [既存店客数_前年比]
        VAR b = [幅_客数]
        RETURN SWITCH ( TRUE (),
            ISBLANK ( v ) || ISBLANK ( b ) || ABS ( v ) <= b, "#A3A29D",
            IF ( v > 0, "#2A78D6", "#EB6834" ) )
    // [7 幅と色] 条件付き書式（フィールド値）に使う。幅の内＝灰、外＝良い青・悪い橙・物価は紫
    MEASURE 'fact_store_day'[色_買上点数] =
        VAR v = [既存店買上点数_前年比]
        VAR b = [幅_買上点数]
        RETURN SWITCH ( TRUE (),
            ISBLANK ( v ) || ISBLANK ( b ) || ABS ( v ) <= b, "#A3A29D",
            IF ( v > 0, "#2A78D6", "#EB6834" ) )
    // [7 幅と色] 条件付き書式（フィールド値）に使う。幅の内＝灰、外＝良い青・悪い橙・物価は紫
    MEASURE 'fact_store_day'[色_一品単価] =
        VAR v = [既存店一品単価_前年比]
        VAR b = [幅_一品単価]
        RETURN SWITCH ( TRUE (),
            ISBLANK ( v ) || ISBLANK ( b ) || ABS ( v ) <= b, "#A3A29D",
            "#5B4FC4" )
    // [7 幅と色] 条件付き書式（フィールド値）に使う。幅の内＝灰、外＝良い青・悪い橙・物価は紫
    MEASURE 'fact_store_day'[色_粗利率] =
        VAR v = [既存店粗利率_廃棄後_前年差]
        VAR b = [幅_粗利率]
        RETURN SWITCH ( TRUE (),
            ISBLANK ( v ) || ISBLANK ( b ) || ABS ( v ) <= b, "#A3A29D",
            IF ( v > 0, "#2A78D6", "#EB6834" ) )
    // [7 幅と色] 条件付き書式（フィールド値）に使う。幅の内＝灰、外＝良い青・悪い橙・物価は紫
    MEASURE 'fact_store_day'[色_廃棄率] =
        VAR v = [既存店廃棄率_前年差]
        VAR b = [幅_廃棄率]
        RETURN SWITCH ( TRUE (),
            ISBLANK ( v ) || ISBLANK ( b ) || ABS ( v ) <= b, "#A3A29D",
            IF ( v > 0, "#EB6834", "#2A78D6" ) )
    // [7 幅と色] 条件付き書式（フィールド値）に使う。幅の内＝灰、外＝良い青・悪い橙・物価は紫
    MEASURE 'fact_store_day'[色_人時粗利] =
        VAR v = [既存店人時粗利_前年比]
        VAR b = [幅_人時粗利]
        RETURN SWITCH ( TRUE (),
            ISBLANK ( v ) || ISBLANK ( b ) || ABS ( v ) <= b, "#A3A29D",
            IF ( v > 0, "#2A78D6", "#EB6834" ) )
    // [7 幅と色] 条件付き書式（フィールド値）に使う。幅の内＝灰、外＝良い青・悪い橙・物価は紫
    MEASURE 'fact_store_day'[色_営業利益] =
        VAR v = [既存店営業利益_前年比]
        VAR b = [幅_営業利益]
        RETURN SWITCH ( TRUE (),
            ISBLANK ( v ) || ISBLANK ( b ) || ABS ( v ) <= b, "#A3A29D",
            IF ( v > 0, "#2A78D6", "#EB6834" ) )

EVALUATE
SUMMARIZECOLUMNS (
    'dim_date'[fy_label],
    FILTER ( VALUES ( 'dim_date'[fy_label] ), 'dim_date'[fy_label] IN { "FY2023", "FY2024", "FY2025" } ),
    "売上", [売上], "営業利益", [営業利益], "既存店売上", [既存店売上], "既存店売上_前年比", [既存店売上_前年比],
    "既存店売上_前年比_曜日補正", [既存店売上_前年比_曜日補正], "既存店客数_前年比", [既存店客数_前年比],
    "既存店買上点数_前年比", [既存店買上点数_前年比], "既存店一品単価_前年比", [既存店一品単価_前年比],
    "既存店廃棄率_前年差", [既存店廃棄率_前年差], "既存店人時粗利_前年比", [既存店人時粗利_前年比],
    "既存店営業利益_前年比", [既存店営業利益_前年比], "幅_売上", [幅_売上], "色_既存店売上", [色_既存店売上]
)
ORDER BY 'dim_date'[fy_label]
